# Public — safe to commit. The anon/publishable key only works because every
# table's Row Level Security policy restricts what it can read (see
# packages/db/migrations/0003_row_level_security.sql and
# docs/08-deployment.md). It is meant to ship in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://eubadixqqwwfoennlaez.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_50rsKf5n3JtXmLuvHCt2Kw_dqWU4zVJ

# Server-only. NEVER put a real value here or in any committed file — this key
# bypasses every RLS policy in the schema. Get it from the Supabase dashboard
# (Project Settings > API > service_role key) and set it only in Vercel's
# environment variables, or a local .env.local (already gitignored).
SUPABASE_SERVICE_ROLE_KEY=

# One passcode gates the whole organizer console, across every tournament —
# see docs/04-organizer-ui.md (A0/A1) and docs/03-data-model.md. Store a
# bcrypt hash here, never the plain passcode.
#
# GOTCHA: in a local .env.local file, Next.js expands $VAR references (see
# https://nextjs.org/docs/app/guides/environment-variables#variable-expansion)
# — and a bcrypt hash is full of literal `$` characters ($2a$10$...), which
# get misread as variable references and silently stripped. Escape every `$`
# as `\$` in .env.local. This only affects local .env files; Vercel's own
# environment variable UI does not do this expansion, so paste the hash there
# unescaped.
ORGANIZER_PASSCODE_HASH=

# Signs the organizer session cookie. Any long random string; rotate it and
# every session is invalidated. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
